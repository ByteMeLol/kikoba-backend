# Application
PROJECT_NAME="VICOBA API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
# Set to true for a non-production tester environment when SMS delivery is unavailable.
EXPOSE_DEBUG_OTP=False

# Server
PORT=8000
HOST="0.0.0.0"

# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/kikoba_db"

# JWT Authentication
SECRET_KEY="replace_this_with_a_super_secret_cryptographic_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Third-Party / Mobile Money Mock or Live
PAYMENT_GATEWAY_URL="https://api.clickpesa.com"
PAYMENT_GATEWAY_API_KEY="mock_key"
PAYMENT_GATEWAY_CLIENT_ID="mock_client_id"
# SMS Gateway (Elive - message.elive.co.tz)
SMS_GATEWAY_URL="https://message.elive.co.tz/api/v1/vendor/message/send"
ELIVE_API_KEY="YOUR_API_KEY"
ELIVE_API_SECRET="YOUR_API_SECRET"
SMS_SENDER_ID="VICOBA"
ELIVE_DELIVERY_REPORT_URL=""
